DATA_MODE=mock
API_PORT=3100
# 仅供本地MOCK联调，不得用于正式环境。
MOCK_ADMIN_USERNAME=admin
MOCK_ADMIN_PASSWORD=readtrace-demo

# 正式环境管理员凭据。真实值只填写在本机.env.local，不得提交。
# ADMIN_USERNAME=replace-with-admin-username
# ADMIN_PASSWORD=replace-with-at-least-16-characters
# mysql模式强制为true且不允许降级；mock模式默认false，可为本地HTTPS显式设为true。
# SESSION_COOKIE_SECURE=true

MYSQL_HOST=db.example.internal
MYSQL_PORT=3306
MYSQL_USER=readtrace_app
MYSQL_PASSWORD=replace-with-local-secret
MYSQL_DATABASE=readtrace
MYSQL_SSL_MODE=required
# MYSQL_SSL_CA_FILE=C:\path\to\ca.pem
DB_CONNECTION_LIMIT=5

# DeepSeek内容分类，仅在本机.env.local填写真实密钥。
DEEPSEEK_API_KEY=replace-with-local-secret
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=30000
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_BATCH_LIMIT=10
DEEPSEEK_BATCH_TOKEN_BUDGET=20000
DEEPSEEK_MAX_OUTPUT_TOKENS=800
DEEPSEEK_MAX_RESPONSE_BYTES=1048576
DEEPSEEK_CLAIM_LEASE_MS=180000
DEEPSEEK_PROMPT_VERSION=content-analysis-v1
